# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/callback

# Supabase — https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# LLM provider: "local" (default) runs a local model via Ollama's
# OpenAI-compatible endpoint; "groq" uses Groq cloud as the primary.
# In local mode the cloud keys below are OPTIONAL fallbacks (local -> Groq -> OpenRouter).
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1:8b          # must be pulled:  ollama pull llama3.1:8b
# LOCAL_LLM_SUMMARY_MODEL=llama3.1:8b  # cheap model for edit summaries (defaults to LOCAL_LLM_MODEL)

# Groq — https://console.groq.com/keys  (required only if LLM_PROVIDER=groq)
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys  (optional last-resort fallback)
OPENROUTER_API_KEY=

# Security
# Generate JWT_SECRET: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your_jwt_secret_here
# Generate ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key_here

# App URLs
FRONTEND_URL=http://localhost:5175
BACKEND_URL=http://localhost:8001

# MCP tool server (optional). Leave unset to run the Gmail MCP server in-process
# (default). Set to a base URL to reach a remotely-deployed MCP server over HTTP.
# MCP_SERVER_URL=https://your-backend.example.com
